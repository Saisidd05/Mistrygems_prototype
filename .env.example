# MongoDB Atlas or self-hosted MongoDB connection string. Do not commit your real value.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mistry_gems?retryWrites=true&w=majority

# Optional. Defaults to "mistry_gems".
MONGODB_DB=mistry_gems

# Google OAuth web client ID. Set the same value in your Vercel environment variables.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Required in production for signed session tokens.
JWT_SECRET=replace-with-a-long-random-secret
